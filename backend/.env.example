PORT=3000
# tmdb (needs TMDB_API_KEY, free at themoviedb.org/settings/api) or fixtures (offline sample data)
# providers: fixtures (offline), moviebox (moviebox.ph)
PROVIDER=moviebox
# Comma-separated browser origins allowed by CORS, or *
CORS_ORIGINS=http://localhost:5173
CACHE_TTL_SECONDS=300
RATE_LIMIT_PER_MINUTE=60
UPSTREAM_TIMEOUT_MS=8000

# Authorized downloads: a folder of files you own or are licensed to share.
# DOWNLOADS_DIR/manifest.json maps "movie-603" or "tv-1396" to its files (see README).
DOWNLOADS_DIR=./media
# Secret used to sign expiring download links. Set a long random value in production.
DOWNLOAD_SIGNING_SECRET=change-me
DOWNLOAD_LINK_TTL_SECONDS=900
# Public URL of this API, used to build absolute download links
PUBLIC_BASE_URL=http://localhost:3000
